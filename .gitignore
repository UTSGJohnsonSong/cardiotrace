# Data — never commit raw NHANES files
data/raw/
data/processed/
*.XPT
*.xpt
*.sas7bdat

# Linked Mortality Files: ignore the data, KEEP the manifest. The manifest is
# the reproducibility record (SHA-256 per file) — CDC revises public-use files
# in place without renaming them, so the digests are what prove two runs read
# the same bytes.
data/raw_mortality/*.dat
!data/raw_mortality/MANIFEST.json

# Environment
.env
*.env
.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# dbt
dbt/target/
dbt/logs/
dbt/.user.yml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Credentials — ignore a root-level profiles.yml, but keep the committed
# dbt/profiles.yml (local Docker creds only, needed for reproducibility).
/profiles.yml

# Claude Code local settings
.claude/

# Derived cohort tables — rebuildable from data/raw via src/cohort.py
data/processed/
